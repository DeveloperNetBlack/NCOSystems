@using NCOSystems.Entity.Parametro
@using NCOSystems.Entity.Personal
@model DocumentoEntity

@using (Html.BeginForm("CreateDocumento", "ConsultaFormulario", FormMethod.Post, new { id = "formDocumento" }))
{
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="IdPersonal" />
    <input type="hidden" asp-for="RutPersonal" />

    <div class="modal-header">
        <h5 class="modal-title">Agregar Documento</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
    </div>

    <div class="modal-body">
        <div class="form-group mb-3">
            <label asp-for="NombreTipoDocumento">Tipo Documento</label>
            @Html.DropDownListFor(m => m.IdTipoDocumento,
                        new SelectList(Model.tipoDocumentoEntities, "IdTipoDocumento", "NombreTipoDocumento"),
                        "Seleccione un Tipo de Documento",
                        new { @class = "form-control" })
            <span asp-validation-for="NombreTipoDocumento" class="text-danger"></span>
        </div>
        <div class="form-group mb-3">
            <label for="archivo">Seleccione nuevo archivo</label>
            <input type="file" name="archivo" id="archivo" class="form-control" required />
        </div>
    </div>
    <div class="modal-footer">
        <button type="submit" class="btn btn-success">Agregar</button>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
    </div>
}
