@using NCOSystems.Entity.Personal
@model PersonalHijoEntity

@using (Html.BeginForm("CreateHijo", "ConsultaFormulario", FormMethod.Post, new { id = "formHijo" }))
{
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="IdPersonal" />

    <div class="modal-header">
        <h5 class="modal-title">Agregar Hijo</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
    </div>

    <div class="modal-body">
        <div class="form-group mb-3">
            <label asp-for="NombreHijo">Nombre Hijo</label>
            <input asp-for="NombreHijo" class="form-control" required />
            <span asp-validation-for="NombreHijo" class="text-danger"></span>
        </div>
        <div class="form-group mb-3">
            <label asp-for="EdadHijo">Edad</label>
            <input asp-for="EdadHijo" type="number" min="0" max="99" class="form-control" required />
            <span asp-validation-for="EdadHijo" class="text-danger"></span>
        </div>
    </div>

    <div class="modal-footer">
        <button type="submit" class="btn btn-success">Agregar</button>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
    </div>
}
